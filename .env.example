# Anthropic API key — required to run the client
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL connection string
# Default matches the docker-compose.yml credentials
DATABASE_URL=postgres://expensory:expensory@localhost:5432/expensory

# REST API listen port
API_PORT=3001

# Point the client/MCP server at the running API.
# Set this when the API is already running (e.g. via Docker Compose)
# so the client does not try to spawn a local API process.
API_BASE=http://localhost:3001
